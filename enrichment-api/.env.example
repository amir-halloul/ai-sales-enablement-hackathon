# Copy to .env for local runs. Never commit .env.

# Shared secret: callers send it in the X-API-Key header (Salesforce Named Credential "Acme_Enrichment").
API_KEY=

# OpenAI (web search research, website extraction, list consolidation)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_REASONING_EFFORT=low
# WEB_SEARCH_MODEL=gpt-6-luna
# WEBSITE_EXTRACTION_MODEL=gpt-6-luna
# CONSOLIDATION_MODEL=gpt-6-luna
# WEB_SEARCH_ENABLED=true
# WEBSITE_ENABLED=true
# CONSOLIDATION_ENABLED=true

# Identity providers: identify and enrich need at least one of them.
ZOOMINFO_ENABLED=false
# ZOOMINFO_CLIENT_ID=
# ZOOMINFO_CLIENT_SECRET=
DNB_ENABLED=false
# DNB_CLIENT_ID=
# DNB_CLIENT_SECRET=

# Runtime
# PORT=8080
# LOG_FORMAT=text   (default JSON logs; text is easier to read locally)
# ENRICHMENT_REQUEST_BUDGET_MS=90000
# RATE_LIMIT_IDENTIFY_PER_MINUTE=
# RATE_LIMIT_ENRICH_PER_MINUTE=

# Optional Snowflake storage (entity table, source cache, history). Leave unset to run stateless.
# SNOWFLAKE_ACCOUNT_URL=
# SNOWFLAKE_PAT=
# SNOWFLAKE_WAREHOUSE=
# ENTITY_STORE_TABLE=
# SOURCE_CACHE_TABLE=
# ENRICHMENT_HISTORY_TABLE=
